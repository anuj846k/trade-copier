# =============================================================================
# Trade Copier — environment configuration
# Copy to `.env` and fill in. Every variable is validated at boot (see
# apps/api/src/config/env.ts) and the API refuses to start with bad values.
# =============================================================================

# --- runtime ----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
# 0.0.0.0 in containers, 127.0.0.1 for local-only
API_HOST=0.0.0.0
API_PORT=4000
PUBLIC_API_URL=http://localhost:4000
# Comma separated list of allowed browser origins for the dashboard
CORS_ORIGINS=http://localhost:3000
# Version reported by /health (set by the release pipeline in CI)
APP_VERSION=0.1.0

# --- database ---------------------------------------------------------------
# PostgreSQL 14+
DATABASE_URL=postgres://trade_copier:trade_copier@localhost:5432/trade_copier
# Used by the integration test suite; tests are skipped when unset
TEST_DATABASE_URL=postgres://trade_copier:trade_copier@localhost:5432/trade_copier_test
DB_POOL_SIZE=10
DB_STATEMENT_TIMEOUT_MS=15000

# --- secrets ----------------------------------------------------------------
# openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# 32-byte key, base64 encoded. Used for AES-256-GCM encryption of broker
# credentials, agent tokens and notification secrets at rest.
# openssl rand -base64 32
ENCRYPTION_KEY=replace-me-with-32-byte-base64-key

# --- engine / worker --------------------------------------------------------
# Run the copy engine + background workers inside the API process
RUN_WORKER_IN_PROCESS=true
# Worker poll interval for the durable command queue
WORKER_POLL_INTERVAL_MS=250
WORKER_BATCH_SIZE=25
# Concurrency per follower account (commands are serialised per account)
WORKER_ACCOUNT_CONCURRENCY=1
# How long a dispatched command waits for the agent's result
COMMAND_TIMEOUT_MS=3000
# Transient broker failures are retried inside this window (docs: 15 minutes)
COPY_RETRY_WINDOW_MS=900000
COPY_MAX_ATTEMPTS=24
# Base/factor for the retry backoff
COPY_RETRY_BASE_MS=500
COPY_RETRY_MAX_MS=30000
# Agent is marked disconnected after this many missed heartbeats
AGENT_HEARTBEAT_INTERVAL_MS=10000
AGENT_HEARTBEAT_GRACE_MS=35000
# Equity/balance snapshot cadence
EQUITY_SNAPSHOT_INTERVAL_MS=15000
# Equity Protection evaluation cadence
EQUITY_PROTECTION_INTERVAL_MS=5000

# --- market data / forex defaults -------------------------------------------
# FX week opens Sunday 21:00 UTC and closes Friday 21:00 UTC (broker dependent)
FX_WEEK_OPEN_UTC=Sunday 21:00
FX_WEEK_CLOSE_UTC=Friday 21:00
# Daily broker maintenance/rollover window during which copying is skipped
FX_DAILY_BREAK_START_UTC=21:00
FX_DAILY_BREAK_END_UTC=22:00
# Max age of a quote used to price a copy decision
QUOTE_MAX_AGE_MS=5000
# Default slippage tolerance in pips when the follower does not set one
DEFAULT_MAX_SLIPPAGE_PIPS=2

# --- notifications ----------------------------------------------------------
# Email channel (nodemailer). Leave SMTP_HOST empty to disable email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Trade Copier <no-reply@example.com>
# Telegram channel (Bot API)
TELEGRAM_BOT_TOKEN=
# Optional shared secret for the generic webhook channel
NOTIFICATION_WEBHOOK_SECRET=

# --- billing (enforcement only, no payment provider wired) ------------------
# Comma separated plan codes offered by the checkout UI
ENABLED_PLAN_CODES=standard_monthly,premium_monthly,premium_annual
# Hard cap on accounts per user when the subscription has no explicit limit
FALLBACK_ACCOUNT_LIMIT=10

# --- bridge agents ----------------------------------------------------------
# Lifetime of the one-time ticket used by the dashboard to open /ws
REALTIME_TICKET_TTL_SECONDS=60
# Interval at which the API pings agents
BRIDGE_PING_INTERVAL_MS=15000

# --- dashboard (apps/web) ---------------------------------------------------
# Public URL of the API as seen by the browser/BFF
NEXT_PUBLIC_API_URL=http://localhost:4000
# Server-side base URL used by the Next.js BFF (inside docker: http://api:4000)
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
# Cookie signing secret for the BFF session cookie
SESSION_COOKIE_SECRET=replace-me-with-at-least-32-random-characters
