{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist-types",
    "rootDir": "src",
    "tsBuildInfoFile": "dist-types/.tsbuildinfo",
    "types": ["node"],
    "composite": true,
    "emitDeclarationOnly": true,
    "lib": ["ES2022"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "dist-types", "node_modules", "test"],
  "references": [
    { "path": "../../packages/contracts" },
    { "path": "../../packages/domain" },
    { "path": "../../packages/broker" }
  ]
}
