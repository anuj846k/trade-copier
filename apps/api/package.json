{
  "name": "@trade-copier/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "dev:worker": "tsx watch --clear-screen=false src/worker.ts",
    "start:worker": "node dist/worker.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/websocket": "^11.0.1",
    "@trade-copier/broker": "workspace:*",
    "@trade-copier/contracts": "workspace:*",
    "@trade-copier/db": "workspace:*",
    "@trade-copier/domain": "workspace:*",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.1",
    "luxon": "^3.5.0",
    "nodemailer": "^6.9.16",
    "pino": "^9.5.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.2",
    "@types/nodemailer": "^6.4.17",
    "@types/ws": "^8.5.13",
    "pino-pretty": "^11.3.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
